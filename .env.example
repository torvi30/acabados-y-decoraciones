PORT=3000
NODE_ENV=development

# Configuración de Base de Datos MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=obra_blanca_db
DB_PORT=3306

# Datos de Negocio (Notificaciones y Redirección WhatsApp)
WHATSAPP_ADMIN_NUMBER=573001234567
COMPANY_NAME=Acabados y Decoraciones Obra Blanca

# ==============================================================================
# CONFIGURACIÓN FIREBASE FIRESTORE (Recomendada: 100% en la nube y gratuita)
# ==============================================================================
# Opción A: Guardar el archivo 'serviceAccountKey.json' directamente en la raíz
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Opción B: Variables de entorno (ideal para Vercel, Render o Railway)
# FIREBASE_PROJECT_ID=tu-proyecto-firebase
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@tu-proyecto.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

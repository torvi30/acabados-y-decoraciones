# Puerto y Entorno
PORT=3000
NODE_ENV=development

# Base de Datos: Firebase Firestore (100% en la nube y tiempo real)
# Opción A: Guardar el archivo 'serviceAccountKey.json' directamente en la raíz del proyecto
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Opción B: Variables de entorno (ideal para Vercel, Render o Railway)
# FIREBASE_PROJECT_ID=tu-proyecto-firebase
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@tu-proyecto.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Datos del Negocio (Notificaciones y Redirección a WhatsApp)
WHATSAPP_ADMIN_NUMBER=573001234567
COMPANY_NAME=Acabados y Decoraciones Obra Blanca

# Credenciales y Seguridad del Panel de Administración (JWT)
ADMIN_EMAIL=admin@obrablanca.com
ADMIN_PASSWORD=admin1234
JWT_SECRET=tu_secreto_super_seguro_jwt_2026_xyz

